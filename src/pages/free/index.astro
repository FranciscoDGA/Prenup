---
import Base from '../../layouts/Base.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
---
<Base
  title="Free Prenup Downloads — Checklists & Scripts | PrenupAnswers"
  description="Printable prenup worksheets you can use tonight: the 17-point checklist and the money-talk script kit. Free, no trial, no credit card."
>
  <section class="article-head">
    <div class="container">
      <p class="crumbs"><a href="/">Home</a> / Free Downloads</p>
      <h1>Free Downloads</h1>
      <p class="meta">Printable worksheets for the two hardest parts of a prenup — the paperwork and the conversation.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lm-grid">
        <div class="lm-card">
          <span class="tag">Printable PDF</span>
          <h3>The 17-Point Prenup Checklist</h3>
          <p>Every item a valid prenup must cover, in the order courts check them: disclosure, terms, execution — plus the five things that never belong in one.</p>
          <a class="btn btn-navy" href="/free/prenup-checklist/">Get the checklist →</a>
        </div>
        <div class="lm-card">
          <span class="tag">Printable PDF</span>
          <h3>The Money Talk Script Kit</h3>
          <p>Four copy-paste sentences for the conversation you've been dreading, the timing rules, and exactly what to say if it goes badly.</p>
          <a class="btn btn-navy" href="/free/money-talk-script/">Get the scripts →</a>
        </div>
        <div class="lm-card">
          <span class="tag">No email needed</span>
          <h3>The Cost Calculator</h3>
          <p>Pick your state and your path (online vs. attorney) and see a real price range in five seconds.</p>
          <a class="btn btn-navy" href="/tools/prenup-cost-calculator/">Open the calculator →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container read" style="text-align:center;">
      <p class="eyebrow">The newsletter</p>
      <h2>The Prenup Brief</h2>
      <p style="color:var(--muted);">
        One honest email a week: cost data, state-law changes, and the conversations couples actually have —
        written for people planning a wedding, not passing the bar.
      </p>
      <div class="sub-hero">
        <SubscribeForm variant="block" cta="Join free" source="free-hub" />
      </div>
    </div>
  </section>
</Base>
