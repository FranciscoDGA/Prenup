---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import SitContext from '../../components/SitContext.astro';
import BriefCta from '../../components/BriefCta.astro';
import { activePartnerUrl } from '../../data/partners';
import { author } from '../../data/author';

export async function getStaticPaths() {
  const posts = await getCollection('guides');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Commercial intent gate (FASE 8/34): 'none' pages never show an affiliate CTA.
// Partner failsafe (FASE 60): if the partner is inactive or the URL is missing,
// fall back to an editorial CTA — never a broken button (FASE 61).
const intent = post.data.commercialIntent;
const affiliateUrl = activePartnerUrl('helloprenup');
const customHref = post.data.ctaHref;
const editorialHref = '/tools/prenup-cost-calculator/';
const showAffiliateCta = intent !== 'none' && !customHref && Boolean(affiliateUrl);
const showEditorialCta = intent !== 'none' && !customHref && !affiliateUrl;
const showCta = intent !== 'none' || Boolean(customHref);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published.toISOString(),
  dateModified: (post.data.updated ?? post.data.published).toISOString(),
  author: {
    '@type': 'Person',
    '@id': `https://www.prenupanswers.com${author.url}#person`,
    name: post.data.author,
    url: `https://www.prenupanswers.com${author.url}`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'PrenupAnswers',
    url: 'https://www.prenupanswers.com/',
  },
  mainEntityOfPage: new URL(`/guides/${post.id}/`, Astro.site).toString(),
};
---
<Base
  title={`${post.data.title} — PrenupAnswers`}
  description={post.data.description}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  jsonLd={articleLd}
>
  <header class="article-head">
    <div class="container">
      <p class="crumbs"><a href="/">Home</a> / <a href="/guides/">Guides</a></p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        By <a href={author.url}>{post.data.author}</a> · Updated{' '}
        {(post.data.updated ?? post.data.published).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })} · {post.data.cluster}
      </p>
      {post.data.image && (
        <figure class="guide-hero">
          <img src={post.data.image} alt={post.data.imageAlt ?? ''} width="1600" height="1067" loading="eager" />
        </figure>
      )}
    </div>
  </header>

  <article class="prose">
    {post.data.tldr && (
      <div class="tldr">
        <b>The short version</b>
        <p style="margin:.4rem 0 0;">{post.data.tldr}</p>
      </div>
    )}
    <Content />
  </article>

  {post.data.primarySituation && <SitContext situationId={post.data.primarySituation} />}

  {showCta && showAffiliateCta && (
    <div class="read" style="padding:0 1.25rem;">
      <CTA
        heading={post.data.ctaHeading ?? 'Skip the $350/hr learning curve'}
        text={post.data.ctaText ?? 'Online prenup services draft a state-specific agreement for a flat fee — most couples with straightforward finances finish for under $1,000.'}
        href={customHref ?? affiliateUrl!}
        label={post.data.ctaLabel ?? 'See what HelloPrenup costs'}
        partnerId={customHref ? undefined : 'helloprenup'}
        pageType="guide"
        contentId={post.id}
      />
    </div>
  )}
  {showCta && customHref && (
    <div class="read" style="padding:0 1.25rem;">
      <CTA
        heading={post.data.ctaHeading ?? 'Looking for professional help?'}
        text={post.data.ctaText ?? 'Once you understand the basics, you may want to compare qualified providers who can advise you about your specific circumstances.'}
        href={customHref}
        label={post.data.ctaLabel ?? 'Explore professional options'}
        pageType="guide"
        contentId={post.id}
      />
    </div>
  )}
  {showCta && showEditorialCta && (
    <div class="read" style="padding:0 1.25rem;">
      <CTA
        heading="See real numbers, not guesses"
        text="Our free cost calculator estimates what couples typically pay in your state — no email, no consultation pitch."
        href={editorialHref}
        label="Open the free cost calculator"
        pageType="guide"
        contentId={post.id}
      />
    </div>
  )}

  <div style="padding:0 1.25rem 2rem;">
    <AuthorBox />
  </div>

  <FAQ items={post.data.faq} />

  <BriefCta source="guide" />
</Base>
