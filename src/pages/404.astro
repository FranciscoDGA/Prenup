---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — PrenupAnswers" description="The page you're looking for doesn't exist.">
  <section class="hero">
    <div class="container">
      <span class="kicker">404</span>
      <h1>This page got divorced from its URL.</h1>
      <p class="lede">The link you followed doesn't exist — but the answers you came for probably do.</p>
      <div class="cta-row">
        <a class="btn btn-gold" href="/">Back to home →</a>
        <a class="btn btn-ghost" href="/guides/">Browse all guides</a>
      </div>
    </div>
  </section>
</Base>
