---
import { author, authorBio } from '../data/author';
---
<div class="author-box">
  {
    author.photo ? (
      <a class="avatar" href={author.url} tabindex="-1" aria-hidden="true">
        <img src={author.photo} alt="" width="52" height="52" loading="lazy" />
      </a>
    ) : (
      <div class="avatar" aria-hidden="true">
        {author.initials}
      </div>
    )
  }
  <div>
    <a class="author-name" href={author.url}>{author.name}</a>
    <span class="author-role"> — {author.role}</span>
    <p>{authorBio}</p>
  </div>
</div>
