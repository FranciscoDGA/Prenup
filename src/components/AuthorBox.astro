---
interface Props {
  name?: string;
  role?: string;
  bio?: string;
}
const {
  name = 'Francisco Gomes',
  role = 'Pastor, marital counselor & founder of PrenupAnswers',
  bio = 'Francisco has spent years beside couples navigating the money conversations most couples avoid. He is also a law student — which is why every claim on this site is sourced, and why the site never pretends to be a law firm.',
} = Astro.props;
---
<div class="author-box">
  <div class="avatar">
    <img src="/images/francisco-gomes.jpg" alt={name} width="52" height="52" loading="lazy" />
  </div>
  <div>
    <b>{name}</b>
    <span style="color:var(--muted); font-size:.85rem;"> — {role}</span>
    <p>{bio}</p>
  </div>
</div>
