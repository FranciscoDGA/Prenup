---
import { SOURCES } from '../data/sources';

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const records = ids.map((id) => SOURCES[id]).filter((s): s is NonNullable<typeof s> => Boolean(s));
---
{
  records.length > 0 && (
    <ol class="source-list">
      {records.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener noreferrer">
            {s.title}
          </a>
          <span class="source-meta">
            {' — '}
            {s.publisher} · {s.jurisdiction} · accessed {s.dateAccessed}
          </span>
        </li>
      ))}
    </ol>
  )
}

<style>
  .source-list {
    margin: 0.75rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .source-list li {
    margin-bottom: 0.55rem;
  }
  .source-meta {
    color: var(--muted);
    font-size: 0.84rem;
  }
</style>
