---
import { formEndpoint, redirectToFor, isSubscribedConfigured } from '../data/subscribe';

interface Props {
  variant?: 'block' | 'inline';
  cta?: string;
  source?: string;
}
const { variant = 'block', cta = 'Subscribe free', source = '' } = Astro.props;
const configured = isSubscribedConfigured();
const next = redirectToFor(source);
---
<form
  class={`sub-form sub-form--${variant}`}
  action={configured ? formEndpoint : ''}
  method={configured ? 'post' : 'get'}
  data-next={next}
  data-source={source}
>
  <input type="hidden" name="ml-submit" value="1" />
  <input type="hidden" name="anticsrf" value="true" />
  <div class="sub-fields">
    {variant === 'block' && (
      <input type="text" name="fields[name]" placeholder="First name (optional)" aria-label="First name" autocomplete="given-name" />
    )}
    <input type="email" name="fields[email]" placeholder="Your email address" aria-label="Email address" required autocomplete="email" />
    <button type="submit" class="btn btn-gold">{cta}</button>
  </div>
  <p class="sub-fine">
    One honest email a week. Unsubscribe in one click. We never sell your address —
    <a href="/privacy/">privacy policy</a>.
  </p>
</form>

<script>
  import { track } from '../scripts/analytics';

  if ('IntersectionObserver' in window) {
    const viewed = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || viewed.has(entry.target)) continue;
          viewed.add(entry.target);
          const source = (entry.target as HTMLElement).dataset.source || 'form';
          track('newsletter_view', { source });
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.4 }
    );
    document.querySelectorAll('.sub-form').forEach((form) => io.observe(form));
  }

  document.addEventListener('submit', async (event) => {
    const form = event.target as HTMLFormElement;
    if (!form.matches('.sub-form') || form.method !== 'post') return;
    event.preventDefault();

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const fine = form.querySelector<HTMLElement>('.sub-fine');
    if (button) button.disabled = true;

    try {
      const body = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (typeof value === 'string') body.append(key, value);
      });

      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
        mode: 'cors',
      });
      const data = await res.json().catch(() => null);
      if (res.ok && data && data.success) {
        track('newsletter_signup', { source: form.dataset.source || 'form' });
        window.location.href = form.dataset.next || '/free/';
      } else {
        throw new Error('subscribe failed');
      }
    } catch {
      if (button) button.disabled = false;
      if (fine) fine.textContent = 'Something went wrong — please try again.';
    }
  });
</script>
